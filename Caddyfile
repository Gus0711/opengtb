{
	admin off
}

:7880 {
	root * /srv
	encode zstd gzip

	# Assets hashés par SvelteKit (/_app/immutable/*) → cache 1 an immutable
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Tout le reste (HTML, sitemap.xml, robots.txt, /og/*, etc.) → revalidation systématique
	@notImmutable not path /_app/immutable/* /api/*
	header @notImmutable Cache-Control "public, max-age=0, must-revalidate"

	# Headers sécurité V1 (sans CSP)
	header X-Content-Type-Options "nosniff"
	header X-Frame-Options "SAMEORIGIN"
	header Referrer-Policy "strict-origin-when-cross-origin"
	header Permissions-Policy "camera=(), microphone=(), geolocation=()"
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	# TODO V2 : ajouter Content-Security-Policy une fois les origines externes
	# consolidées (fonts inlinées, OG image, éventuels analytics).
	# Définir une CSP stricte default-src 'self' à ce moment-là.

	# Compteur de visites (service `counter` du docker-compose)
	handle /api/* {
		reverse_proxy counter:8080
	}

	# adapter-static produit /outils/decode.html, pas /outils/decode/index.html.
	# Caddy file_server ne tente pas <path>.html par défaut — on l'ajoute via
	# try_files pour que /outils/decode résolve vers decode.html.
	handle {
		try_files {path} {path}.html {path}/index.html
		file_server
	}
}
