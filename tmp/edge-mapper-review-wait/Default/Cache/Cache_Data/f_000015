	const edges = $.tag($.derived(() => [...$.get(pointEdges), ...$.get(uplinkEdges)]), 'edges');

	const filteredPoints = $.tag(
		$.derived(() => {
			const needle = $.get(search).trim().toLocaleLowerCase('fr');

			return $.get(allPoints).filter(({ equipment: item, point }) => {
				const matchesSearch = !needle || `${item.name} ${point.name} ${point.signal} ${point.address} ${targetName(point.targetId)}`.toLocaleLowerCase('fr').includes(needle);
				const matchesKind = $.strict_equals($.get(kindFilter), 'all') || $.strict_equals(point.kind, $.get(kindFilter));
				const matchesStatus = $.strict_equals($.get(statusFilter), 'all') || $.strict_equals($.get(statusFilter), 'assigned') && Boolean(point.targetId) || $.strict_equals($.get(statusFilter), 'unassigned') && !point.targetId || $.strict_equals($.get(statusFilter), 'issues') && $.get(issueMap).has(point.id);

				return matchesSearch && matchesKind && matchesStatus;
			}).toSorted((a, b) => {
				const values = {
					equipment: [a.equipment.name, b.equipment.name],
					point: [a.point.name, b.point.name],
					kind: [a.point.kind, b.point.kind],
					target: [targetName(a.point.targetId), targetName(b.point.targetId)],
					address: [a.point.address, b.point.address]
				};

				return values[$.get(sortKey)][0].localeCompare(values[$.get(sortKey)][1], 'fr', { numeric: true });
			});
		}),
		'filteredPoints'
	);

	function cloneTargets(items) {
		return items.map((item) => normalizeTarget({ ...item }));
	}

	function cloneSupervisors(items) {
		return items.map((item) => ({ ...item }));
	}

	function cloneEquipment(items) {
		return items.map((item) => normalizeEquipment({ ...item, points: item.points.map((point) => ({ ...point })) }));
	}

	function harvestPositions() {
		if ($.get(nodes).length) $.set(positions, Object.fromEntries($.get(nodes).map((node) => [node.id, { ...node.position }])), true);
	}

	function projectSnapshot() {
		harvestPositions();

		return JSON.stringify({
			version: 1,
			title: $.get(title),
			supervisors: $.get(supervisors),
			targets: $.get(targets),
			equipment: $.get(equipment),
			layout: { positions: $.get(positions), viewport: $.get(viewport) }
		});
	}

	function persist() {
		if (browser) localStorage.setItem(STORAGE_KEY, projectSnapshot());
	}

	function flash(message) {
		$.set(notification, message, true);

		setTimeout(
			() => {
				if ($.strict_equals($.get(notification), message)) $.set(notification, '');
			},
			2200
		);
	}

	function applyProject(project) {
		$.set(title, $.strict_equals(typeof project.title, 'string') ? project.title : 'Architecture GTB', true);

		// Les projets antérieurs au modèle de bus ont des points réseau sans segment :
		// on les reclasse sous le bus correspondant avant d'alimenter l'état.
		const migrated = migrateBusAttachments({
			title: '',
			supervisors: Array.isArray(project.supervisors) ? project.supervisors : [],
			targets: cloneTargets(Array.isArray(project.targets) ? project.targets : []),
			equipment: cloneEquipment(Array.isArray(project.equipment) ? project.equipment : [])
		});

		$.set(supervisors, cloneSupervisors(migrated.supervisors), true);
		$.set(targets, migrated.targets, true);
		$.set(equipment, migrated.equipment, true);
		$.set(positions, { ...project.layout?.positions ?? {} }, true);
		$.set(viewport, { ...project.layout?.viewport ?? { x: 32, y: 32, zoom: 0.75 } }, true);
		$.set(fitInitial, !project.layout?.viewport);
		$.set(canvasKey, $.get(canvasKey) + 1);
		$.set(focus, null);
		$.set(inspectorPointId, null);
		nextId = Math.max(100, $.get(equipment).length + $.get(targets).length + $.get(supervisors).length + Date.now() % 10000);
		syncNodes();
	}

	function commit(action) {
		const before = projectSnapshot();

		action();
		$.set(undoStack, [...$.get(undoStack).slice(-(HISTORY_LIMIT - 1)), before]);
		$.set(redoStack, []);
		syncNodes();
		persist();
	}

	function undo() {
		const previous = $.get(undoStack).at(-1);

		if (!previous) return;

		$.set(redoStack, [...$.get(redoStack), projectSnapshot()]);
		$.set(undoStack, $.get(undoStack).slice(0, -1));
		applyProject(JSON.parse(previous));
		persist();
		flash('Modification annulée');
	}

	function redo() {
		const next = $.get(redoStack).at(-1);

		if (!next) return;

		$.set(undoStack, [...$.get(undoStack), projectSnapshot()]);
		$.set(redoStack, $.get(redoStack).slice(0, -1));
		applyProject(JSON.parse(next));
		persist();
		flash('Modification rétablie');
	}

	function syncNodes() {
		const current = new Map($.get(nodes).map((node) => [node.id, node]));

		const equipmentNodes = $.get(equipment).map((item, index) => ({
			id: item.id,
			type: 'equipment',
			position: $.get(positions)[item.id] ?? current.get(item.id)?.position ?? defaultNodePosition('equipment', index),
			dragHandle: '.node-drag-handle',
			selected: current.get(item.id)?.selected ?? false,
			data: {
				kind: 'equipment',
				item,
				active: isEquipmentActive(item),
				bulkTargets: $.get(targets).filter((target) => item.points.length > 0 && item.points.every((point) => targetAccepts(target.kind, point.kind))),
				selectedPointId: $.get(inspectorPointId),
				onFocus: focusEquipment,
				onRename: updateEquipment,
				onRemove: removeEquipment,
				onOpenPoint: openPoint,
				onClosePoint: closePoint,
				onRemovePoint: removePoint,
				onAddPoint: addPoint,
				onChangePointKind: changePointKind,
				onUpdatePoint: updatePoint,
				onUnassignPoint: unassignPoint,
				onSelectConnection: selectPointConnection,
				onAssignAll: assignAllPoints,
				bus: equipmentBusView(item),
				onAttachSegment: attachSegment,
				onSetDeviceAddress: setDeviceAddress
			}
		}));

		const targetNodes = $.get(targets).map((item, index) => ({
			id: item.id,
			type: 'target',
			position: $.get(positions)[item.id] ?? current.get(item.id)?.position ?? defaultNodePosition('target', index),
			dragHandle: '.node-drag-handle',
			selected: current.get(item.id)?.selected ?? false,
			data: {
				kind: 'target',
				item,
				...targetPointGroups(item),
				supervisors: $.get(supervisors),
				supervisor: $.get(supervisors).find((entry) => $.strict_equals(entry.id, item.supervisorId)) ?? null,
				active: isTargetActive(item),
				onFocus: focusTarget,
				onRename: updateTarget,
				onRemove: removeTarget,
				onOpenPoint: openPoint,
				onConnectPending: connectPendingPoint,
				onAssignSupervisor: assignSupervisor,
				onSetUplink: setUplink,
				onSelectUplink: selectUplinkConnection,
				onUpdateSegment: updateSegment,
				onRemoveSegment: removeSegment
			}
		}));

		const supervisorNodes = $.get(supervisors).map((item, index) => ({
			id: item.id,
			type: 'supervisor',
			position: $.get(positions)[item.id] ?? current.get(item.id)?.position ?? defaultNodePosition('supervisor', index),
			dragHandle: '.node-drag-handle',
			selected: current.get(item.id)?.selected ?? false,
			data: {
				kind: 'supervisor',
				item,
				uplinks: $.get(targets).filter((target) => $.strict_equals(target.supervisorId, item.id)),
				active: isSupervisorActive(item),
				onFocus: focusSupervisor,
				onFocusTarget: focusTarget,
				onRename: updateSupervisor,
				onRemove: removeSupervisor,
				onConnectPending: connectPendingUplink
			}
		}));

		$.set(nodes, [...equipmentNodes, ...targetNodes, ...supervisorNodes]);
	}

	/** Chaque point affecté doit avoir exactement un handle : E/S câblée, bus, ou groupe orphelin. */
	function targetPointGroups(item) {
		const assigned = $.get(allPoints).filter(({ point }) => $.strict_equals(point.targetId, item.id));
		const segments = segmentViews(item);
		const grouped = new Set(segments.flatMap((view) => view.points.map((row) => row.point.id)));

		return {
			assigned,
			segments,
			physical: assigned.filter(({ point }) => !isBusKind(point.kind)),
			orphanNetwork: assigned.filter(({ point }) => isBusKind(point.kind) && !grouped.has(point.id))
		};
	}

	function setFocus(next) {
		$.set(focus, next, true);
		syncNodes();
	}

	function focusEquipment(id) {
		setFocus({ type: 'equipment', id });
	}

	function focusTarget(id) {
		setFocus({ type: 'target', id });
	}

	function focusSupervisor(id) {
		setFocus({ type: 'supervisor', id });
	}

	function addSupervisor(kind) {
		commit(() => {
			const item = createSupervisor(kind, `${kind}-${nextId++}`, uniqueName(SUPERVISOR_DEFINITIONS[kind].defaultName, $.get(supervisors).map((entry) => entry.name)));

			$.get(positions)[item.id] = freeNodePosition('supervisor', Object.values($.get(positions)));
			$.set(supervisors, [...$.get(supervisors), item], true);
			$.set(focus, { type: 'supervisor', id: item.id }, true);
		});
	}

	function updateSupervisor(id, name) {
		$.set(supervisors, $.get(supervisors).map((item) => $.strict_equals(item.id, id) ? { ...item, name } : item), true);
		syncNodes();
		persist();
	}

	function removeSupervisor(id) {
		commit(() => {
			$.set(supervisors, $.get(supervisors).filter((item) => $.strict_equals(item.id, id, false)), true);
			$.set(targets, $.get(targets).map((item) => $.strict_equals(item.supervisorId, id) ? { ...item, supervisorId: null } : item), true);
			delete $.get(positions)[id];

			if ($.strict_equals($.get(focus)?.id, id)) $.set(focus, null);
		});
	}

	function assignSupervisor(targetId, supervisorId) {
		commit(() => $.set(
			targets,
			$.get(targets).map((item) => $.strict_equals(item.id, targetId)
				? { ...item, supervisorId: supervisorId || null }
				: item),
			true
		));
	}

	function setUplink(targetId, protocol) {
		commit(() => $.set(targets, $.get(targets).map((item) => $.strict_equals(item.id, targetId) ? { ...item, uplink: protocol } : item), true));
	}

	function selectUplinkConnection(targetId) {
		clearConnectionEndTimer();
		$.set(connectingPointId, null);
		$.set(connectingTargetId, targetId, true);
	}

	function connectPendingUplink(supervisorId) {
		clearConnectionEndTimer();

		const pending = $.get(connectingTargetId);

		$.set(connectingTargetId, null);

		if (!pending || !$.get(supervisors).some((item) => $.strict_equals(item.id, supervisorId))) return;

		assignSupervisor(pending, supervisorId);
	}

	function addTarget(kind) {
		commit(() => {
			const item = createTarget(kind, `${kind}-${nextId++}`, uniqueName(TARGET_DEFINITIONS[kind].defaultName, $.get(targets).map((entry) => entry.name)));

			$.get(positions)[item.id] = freeNodePosition('target', Object.values($.get(positions)));
			$.set(targets, [...$.get(targets), item], true);
			$.set(focus, { type: 'target', id: item.id }, true);
		});
	}

	function updateTarget(id, name) {
		$.set(targets, $.get(targets).map((item) => $.strict_equals(item.id, id) ? { ...item, name } : item), true);
		syncNodes();
		persist();
	}

	function removeTarget(id) {
		commit(() => {
			const orphans = new Set($.get(targets).find((item) => $.strict_equals(item.id, id))?.segments.map((segment) => segment.id) ?? []);

			$.set(targets, $.get(targets).filter((item) => $.strict_equals(item.id, id, false)), true);

			$.set(
				equipment,
				$.get(equipment).map((item) => ({
					...item,
					points: item.points.map((point) => $.strict_equals(point.targetId, id) ? { ...point, targetId: null, address: '' } : point)
				})),
				true
			);

			detachOrphans(orphans);
			delete $.get(positions)[id];

			if ($.strict_equals($.get(focus)?.id, id)) $.set(focus, null);
		});
	}

	function addEquipment(kind) {
		commit(() => {
			const item = createEquipment(kind, `${kind}-${nextId++}`);

			item.name = uniqueName(item.name, $.get(equipment).map((entry) => entry.name));
			$.get(positions)[item.id] = freeNodePosition('equipment', Object.values($.get(positions)));
			$.set(equipment, [...$.get(equipment), item], true);
			$.set(focus, { type: 'equipment', id: item.id }, true);
		});
	}

	function updateEquipment(id, name) {
		$.set(equipment, $.get(equipment).map((item) => $.strict_equals(item.id, id) ? { ...item, name } : item), true);
		syncNodes();
		persist();
	}

	function removeEquipment(id) {
		commit(() => {
			const pointIds = new Set($.get(equipment).find((item) => $.strict_equals(item.id, id))?.points.map((point) => point.id) ?? []);

			$.set(equipment, $.get(equipment).filter((item) => $.strict_equals(item.id, id, false)), true);
			delete $.get(positions)[id];

			if ($.strict_equals($.get(focus)?.id, id) || $.strict_equals($.get(focus)?.type, 'point') && pointIds.has($.get(focus).id)) $.set(focus, null);
			if ($.get(inspectorPointId) && pointIds.has($.get(inspectorPointId))) $.set(inspectorPointId, null);
		});
	}

	function updatePoint(equipmentId, pointId, patch, withHistory = false) {
		const action = () => $.set(
			equipment,
			$.get(equipment).map((item) => $.strict_equals(item.id, equipmentId)
				? {
					...item,
					points: item.points.map((point) => $.strict_equals(point.id, pointId) ? { ...point, ...patch } : point)
				}
				: item),
			true
		);

		if (withHistory) commit(action); else {
			action();
			syncNodes();
			persist();
		}
	}

	function changePointKind(equipmentId, point, kind) {
		const item = $.get(equipment).find((entry) => $.strict_equals(entry.id, equipmentId));
		const protocol = item ? equipmentProtocol(item.kind) : null;
		const nextKind = protocol?.kind ?? kind;
		const current = $.get(targets).find((target) => $.strict_equals(target.id, point.targetId));
		const keep = current && targetAccepts(current.kind, nextKind);

		updatePoint(
			equipmentId,
			point.id,
			{
				kind: nextKind,
				signal: protocol?.signal ?? defaultSignal(nextKind),
				targetId: keep ? current.id : null,
				address: keep ? point.address : ''
			},
			true
		);
	}

	// Une E/S câblée prend une borne libre de l'automate ; un registre est numéroté dans son propre équipement.
	function addressScope(equipmentId, point, targetId) {
		return isBusKind(point.kind)
			? $.get(allPoints).filter((row) => $.strict_equals(row.equipment.id, equipmentId) && $.strict_equals(row.point.id, point.id, false)).map((row) => row.point.address)
			: $.get(allPoints).filter((row) => $.strict_equals(row.point.targetId, targetId) && $.strict_equals(row.point.id, point.id, false)).map((row) => row.point.address);
	}

	function suggestAddress(equipmentId, point, targetId) {
		return nextFreeAddress(point.kind, addressScope(equipmentId, point, targetId));
	}

	function assignTarget(equipmentId, point, targetId) {
		// Raccorder un point de bus, c'est raccorder l'équipement : l'adresse esclave est portée par le device.
		if (targetId && equipmentBus($.get(equipment).find((item) => $.strict_equals(item.id, equipmentId))?.kind ?? 'custom')) {
			attachToSegment(equipmentId, targetId);

			return;
		}

		updatePoint(
			equipmentId,
			point.id,
			{
				targetId: targetId || null,
				address: targetId
					? point.address || suggestAddress(equipmentId, point, targetId)
					: ''
			},
			true
		);
	}

	/** Accroche l'équipement au segment adapté de la cible (créé au besoin) et affecte tous ses points. */
	function attachToSegment(equipmentId, targetId) {
		const item = $.get(equipment).find((entry) => $.strict_equals(entry.id, equipmentId));
		const required = item ? equipmentBus(item.kind) : null;

		if (!item || !required) return;

		const host = $.get(targets).find((entry) => $.strict_equals(entry.id, targetId));

		if (!host || !targetAccepts(host.kind, required.kind)) return;

		commit(() => {
			const { target: updated, segment } = ensureSegment(host, required.kind, required.media, `segment-${nextId++}`);

			$.set(targets, $.get(targets).map((entry) => $.strict_equals(entry.id, targetId) ? updated : entry), true);

			const profile = segmentProfile(segment);
			const used = $.get(equipment).filter((entry) => $.strict_equals(entry.id, equipmentId, false) && $.strict_equals(entry.bus?.segmentId, segment.id)).map((entry) => entry.bus?.address ?? '');
			const keep = $.strict_equals(item.bus?.segmentId, segment.id) && item.bus.address ? item.bus.address : '';
			const address = keep || nextFreeDeviceAddress(profile, used);
			const registers = new Set();

			$.set(
				equipment,
				$.get(equipment).map((entry) => $.strict_equals(entry.id, equipmentId, false)
					? entry
					: {
						...entry,
						bus: { segmentId: segment.id, address },
						points: entry.points.map((point) => {
							const current = point.address.trim().toUpperCase();

							const register = current && !registers.has(current)
								? point.address
								: nextFreeAddress(point.kind, registers);

							registers.add(register.trim().toUpperCase());

							return { ...point, targetId, address: register };
						})
					}),
				true
			);
		});
	}

	function detachFromSegment(equipmentId) {
		commit(() => $.set(
			equipment,
			$.get(equipment).map((entry) => $.strict_equals(entry.id, equipmentId, false)
				? entry
				: {
					...entry,
					bus: { segmentId: null, address: '' },
					points: entry.points.map((point) => ({ ...point, targetId: null }))
				}),
			true
		));
	}

	function setDeviceAddress(equipmentId, address) {
		$.set(
			equipment,
			$.get(equipment).map((entry) => $.strict_equals(entry.id, equipmentId, false)
				? entry
				: {
					...entry,
					bus: { segmentId: entry.bus?.segmentId ?? null, address }
				}),
			true
		);

		syncNodes();
		persist();
	}

	function updateSegment(targetId, segmentId, patch) {
		$.set(
			targets,
			$.get(targets).map((entry) => $.strict_equals(entry.id, targetId, false)
				? entry
				: {
					...entry,
					segments: entry.segments.map((segment) => $.strict_equals(segment.id, segmentId) ? { ...segment, ...patch } : segment)
				}),
			true
		);

		syncNodes();
		persist();
	}

	function removeSegment(targetId, segmentId) {
		commit(() => {
			$.set(
				targets,
				$.get(targets).map((entry) => $.strict_equals(entry.id, targetId, false)
					? entry
					: {
						...entry,
						segments: entry.segments.filter((segment) => $.strict_equals(segment.id, segmentId, false))
					}),
				true
			);

			$.set(
				equipment,
				$.get(equipment).map((entry) => $.strict_equals(entry.bus?.segmentId, segmentId, false)
					? entry
					: {
						...entry,
						bus: { segmentId: null, address: '' },
						points: entry.points.map((point) => ({ ...point, targetId: null }))
					}),
				true
			);
		});
	}

	function assignAllPoints(equipmentId, targetId) {
		const item = $.get(equipment).find((entry) => $.strict_equals(entry.id, equipmentId));
		const target = $.get(targets).find((entry) => $.strict_equals(entry.id, targetId));

		if (!item || !target || !item.points.length || !item.points.every((point) => targetAccepts(target.kind, point.kind))) return;

		if (equipmentBus(item.kind)) {
			attachToSegment(equipmentId, targetId);
			flash(`${item.name} raccordé à ${target.name}`);

			return;
		}

		commit(() => {
			const taken = new Set($.get(allPoints).filter((row) => $.strict_equals(row.equipment.id, equipmentId, false) && $.strict_equals(row.point.targetId, targetId)).map((row) => row.point.address.trim().toUpperCase()).filter(Boolean));

			$.set(
				equipment,
				$.get(equipment).map((entry) => $.strict_equals(entry.id, equipmentId, false)
					? entry
					: {
						...entry,
						points: entry.points.map((point) => {
							// Une adresse déjà posée sur cette cible est conservée, sauf si elle entre en conflit.
							const current = point.address.trim().toUpperCase();

							const keep = $.strict_equals(point.targetId, targetId) && current && !taken.has(current);
							const address = keep ? point.address : nextFreeAddress(point.kind, taken);

							taken.add(address.trim().toUpperCase());

							return { ...point, targetId, address };
						})
					}),
				true
			);
		});

		flash(`${item.points.length} points affectés à ${target.name}`);
	}

	function unassignPoint(equipmentId, point) {
		// Un point de bus n'existe qu'a travers son device : le detacher detache l'equipement entier.
		if (equipmentBus($.get(equipment).find((item) => $.strict_equals(item.id, equipmentId))?.kind ?? 'custom')) {
			detachFromSegment(equipmentId);

			return;
		}

		assignTarget(equipmentId, point, '');
	}

	/** Coupe les rattachements qui pointent vers des segments disparus avec leur cible. */
	function detachOrphans(removedSegmentIds) {
		if (!removedSegmentIds.size) return;

		$.set(
			equipment,
			$.get(equipment).map((item) => removedSegmentIds.has(item.bus?.segmentId ?? '')
				? { ...item, bus: { segmentId: null, address: '' } }
				: item),
			true
		);
	}

	function addPoint(equipmentId) {
		const id = `${equipmentId}-point-${nextId++}`;

		commit(() => $.set(
			equipment,
			$.get(equipment).map((item) => {
				if ($.strict_equals(item.id, equipmentId, false)) return item;

				const protocol = equipmentProtocol(item.kind);
				const kind = protocol?.kind ?? 'AI';

				return {
					...item,
					points: [
						...item.points,
						{
							id,
							name: 'Nouveau point',
							kind,
							signal: protocol?.signal ?? defaultSignal(kind),
							address: '',
							targetId: null
						}
					]
				};
			}),
			true
		));

		openPoint(id);
	}

	function removePoint(equipmentId, pointId) {
		commit(() => {
			$.set(
				equipment,
				$.get(equipment).map((item) => $.strict_equals(item.id, equipmentId)
					? {
						...item,
						points: item.points.filter((point) => $.strict_equals(point.id, pointId, false))
					}
					: item),
				true
			);

			if ($.strict_equals($.get(focus)?.id, pointId)) $.set(focus, null);
			if ($.strict_equals($.get(inspectorPointId), pointId)) $.set(inspectorPointId, null);
		});
	}

	function openPoint(pointId) {
		const closing = $.strict_equals($.get(inspectorPointId), pointId);

		$.set(inspectorPointId, closing ? null : pointId, true);
		setFocus(closing ? null : { type: 'point', id: pointId });
