# Token requis pour accéder à l'admin SVG en dev (/_admin/svg).
# Génère-en un avec : openssl rand -hex 24
# Le plugin Vite refuse toutes les requêtes /__svg-admin/* si ce token ne matche pas.
# Le plugin est désactivé en build (adapter-static) → aucun endpoint admin en prod.
ADMIN_TOKEN=

# Météo-France — API DPClim (Données Publiques de Climatologie)
# Utilisée par les scripts scripts/dju/*.ts pour fetch des températures
# et calculer les DJU par station.
#
# Comment l'obtenir :
#   1. Créer un compte sur https://portail-api.meteofrance.fr/
#   2. Souscrire à l'API "DPClim — Données Publiques de Climatologie"
#   3. Application ID = chaîne base64 du couple client_id:client_secret
MF_APPLICATION_ID=

# ─── Prod (VPS) — service `api` du docker-compose ───────────────────────────
# Tunnel Cloudflare (Zero Trust → Networks → Tunnels) + profil qui le démarre.
TUNNEL_TOKEN=
COMPOSE_PROFILES=tunnel

# Modération du fil /messages : supprimer un message via la page /messages#admin.
# Génère-en un avec : openssl rand -hex 24
MESSAGES_ADMIN_TOKEN=

# Cloudflare Turnstile (anti-robot du formulaire /messages).
# Dashboard Cloudflare → Turnstile → Add widget (domaine opengtb.fr, mode Managed).
# Vides = vérification désactivée (dev) ; les autres couches anti-spam restent actives.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Optionnel : notification à chaque nouveau message (ex. https://ntfy.sh/<sujet-secret>).
NTFY_URL=
